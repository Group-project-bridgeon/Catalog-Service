PORT=8081
GIN_MODE=release

DATABASE_URL=postgres://catalog_service:change_me_catalog_password@127.0.0.1:5433/catalog_db?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_STATEMENT_TIMEOUT=5s

HTTP_MAX_BODY_BYTES=1048576
HTTP_SLOW_REQUEST_THRESHOLD=500ms

REFERENCE_CACHE_TTL=45s
# Required: public key derived from Authentication's signing key (never private).
JWT_PUBLIC_KEY_PATH=../Authentication/keys/jwt-public.pem
JWT_ISSUER=erp-auth
JWT_AUDIENCE=erp-api
